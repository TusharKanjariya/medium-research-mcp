# medium-research-mcp — credential template (CRED-03)
#
# Copy to `.env` for local/dev use (.env is gitignored — only THIS file is committed).
# NAMES + COMMENTS ONLY: never put a real or sample secret value in this file.
# credentials.js (shared/credentials.js) is the single reader of every variable below.
#
# For distributed .mcpb bundles these same variables are injected from the OS keychain
# via user_config fields marked "sensitive": true (see servers/hn/manifest.json).

# --- Required credentials --------------------------------------------------------
# These sources fail loudly with a clear "set X" error when the variable is missing.

# Libraries.io API key — REQUIRED for the Libraries.io source (Phase 3+).
LIBRARIESIO_KEY=

# Product Hunt developer token — REQUIRED for the Product Hunt source (Phase 3+).
PRODUCTHUNT_TOKEN=

# --- Optional credentials (keyless / anonymous degrade) --------------------------
# Absent = the source runs anonymously; set to raise rate limits or unlock content.

# Stack Exchange API key — OPTIONAL; raises the request quota (keyless otherwise).
STACKEXCHANGE_KEY=

# GitHub personal access token — OPTIONAL; raises rate limits (anonymous otherwise).
GITHUB_TOKEN=

# --- Reddit (OPTIONAL password grant) --------------------------------------------
# Reddit reads are KEYLESS by default (www.reddit.com/r/<sub>/.json). The optional
# OAuth2 password grant activates ONLY when ALL FOUR variables below are set AND you
# have registered a "script" app. NOTE (honesty caveat, D-04): username/password alone
# is NOT enough — the grant needs a karma-gated script app for its client_id/secret.
# With 2FA, append ":TOTP" to REDDIT_PASSWORD.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- Lemmy (OPTIONAL login) ------------------------------------------------------
# Lemmy needs only instance + username + password (no app registration, unlike Reddit).
# Instance is the full base URL, e.g. https://lemmy.ml
LEMMY_INSTANCE=
LEMMY_USERNAME=
LEMMY_PASSWORD=

# --- Outbound identity -----------------------------------------------------------
# User-Agent for outbound requests. OPTIONAL — a sane default is used when unset, but
# Reddit requires a real, non-blank UA, so set a descriptive one for authenticated use.
MCP_USER_AGENT=

# --- RSS fetcher host allowlist (OPTIONAL hardening knob, NOT a credential) ------
# Comma-separated list of hostnames the rss_fetch tool is allowed to reach (D-03).
# UNSET (default) = any public host is fetchable EXCEPT the built-in private-range
# denylist (loopback, RFC1918, link-local incl. 169.254.169.254, CGNAT, IPv6 ULA).
# SET = lock-down mode — only the listed hosts pass the SSRF guard. Example:
#   RSS_ALLOWED_HOSTS=news.ycombinator.com,www.reddit.com,www.youtube.com
RSS_ALLOWED_HOSTS=
